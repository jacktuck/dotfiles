{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "*git*push*": "ask",
      "*ansible-playbook*": "ask",
      "*ssh*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/code/**": "allow",
      "~/work/**": "allow",
      "~/ai/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
